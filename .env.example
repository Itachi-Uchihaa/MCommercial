# Copier ce fichier en .env.local (en local) et saisir les mêmes variables dans Vercel.

# Clés publiques : elles peuvent être visibles, les données sont protégées
# par les règles d'accès (RLS) côté Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://ibijhyocvxdwxgmtftkf.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_FPZtP_3V8owSx0kU-Gqbqg_pADhVesF

# Seuls ces emails accèdent à l'espace Administration (séparés par des virgules).
# Sans cette variable, personne n'y a accès.
ADMIN_EMAILS=

# Notifications push (clés VAPID) : générer une paire avec « npx web-push generate-vapid-keys ».
# La publique part dans le navigateur, la privée reste SECRÈTE.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Secret de la tâche planifiée du matin (« openssl rand -hex 24 »). Vercel Cron l'envoie tout seul.
CRON_SECRET=

# Clé SECRÈTE, utilisée uniquement côté serveur par l'espace Administration
# (créer / supprimer des comptes). Ne jamais la committer ni la partager.
# Supabase → Project Settings → API Keys → Secret keys → copier la clé « sb_secret_… »
SUPABASE_SECRET_KEY=
